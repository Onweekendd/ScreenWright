# docker compose 部署用的环境变量。复制成 .env 后修改：
#   cp .env.compose.example .env

# ── 必填 ──
# 数据库口令
POSTGRES_PASSWORD=change-me
# JWT 签名密钥（api / ai 共用，必须一致）。生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# MinIO 管理口令（至少 8 位）
MINIO_ROOT_PASSWORD=change-me-too

# ── 站点地址 ──
# 浏览器访问站点用的地址，素材直链会用它拼接。对外用域名 / HTTPS 时改成对应地址，如 https://bi.example.com
PUBLIC_ORIGIN=http://localhost:8080
# 宿主机对外端口
HTTP_PORT=8080

# ── 初始管理员 ──
SEED_ADMIN_NAME=admin
# 留空则随机生成，并只在 migrate 容器日志里打印一次：docker compose logs migrate
SEED_ADMIN_PASSWORD=

# ── 构建 ──
# 国内网络可改用镜像：https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org

# ── 模型（可选）──
# 只是首启兜底，之后在编辑器「设置」页维护。全部留空也能启动。
# REASONING_MODEL_BASE_URL=
# REASONING_MODEL_API_KEY=
# REASONING_MODEL_ID=
# VISION_MODEL_BASE_URL=
# VISION_MODEL_API_KEY=
# VISION_MODEL_ID=
# EMBEDDING_MODEL_BASE_URL=
# EMBEDDING_MODEL_API_KEY=
# EMBEDDING_MODEL_ID=
# IMAGE_MODEL_BASE_URL=
# IMAGE_MODEL_API_KEY=
# IMAGE_MODEL_ID=

# ── 联网素材搜索 MCP（可选；需从 ai 容器访问该地址）──
# Answer Media Agent 素材 MCP 地址（不是 Answer 站点的 /answer/api/v1/mcp/sse 问答 MCP）。
# 若素材服务和 FunBI AI 容器在同一 Docker 网络，可填 http://<服务名>:8766/mcp。
# 地址必须能从 AI 容器访问；127.0.0.1 会指向 AI 容器自身。
# MEDIA_ASSETS_MCP_URL=
# MCP 服务签发的 Bearer Token。请在服务器的 .env 中填写，不要提交到 Git。
# MEDIA_ASSETS_MCP_TOKEN=
