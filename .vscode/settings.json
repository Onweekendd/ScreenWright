{
  // 保存时自动格式化，使用 Prettier 作为默认格式化器
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // 保存时自动修复 ESLint 可修复的问题
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // 各语言显式指定 Prettier 为格式化器，避免被其他插件抢占
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // ESLint：使用 flat config（eslint.config.js），并在 monorepo 各包内就近解析配置
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.validate": ["javascript", "typescript", "vue", "typescriptreact"],
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-containers"
  },
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },

  // 仓库根没有 Cargo.toml，显式告诉 rust-analyzer 各个 Rust 子项目的位置
  "rust-analyzer.linkedProjects": [
    "apps/desktop/src-tauri/Cargo.toml",
    "packages/alignment-wasm/Cargo.toml"
  ]
}
