# 桌面端（Tauri 外壳）构建 / 联调环境
# 阶段 A：后端 + PG + MinIO 仍由 docker-compose / 本地 pnpm server:dev 提供，
# 这里只把前端的接口地址统一指向本机 funAI（4111）。
VITE_NODE_ENV=production
# Tauri 从 tauri://localhost 加载，必须走根路径
VITE_PUBLIC_PATH=/
# 系统接口（/user、/bi-system 回落路由，均由本机 funAI 提供）
VITE_API_BASE_URL=http://127.0.0.1:4111
VITE_API_BASE_URL_CITY=
# minio 素材库（docker-compose 里映射到 9002）
VITE_MINIO_BASE_URL=http://127.0.0.1:9002/
VITE_MINIO_DEFAULT_PREFIX=version-test/
VITE_RESOURCE_BASE_URL=http://127.0.0.1:4111
VITE_SOCKET_IO_URL=
VITE_DOCUMENT_URL=
VITE_WEBSITE_ORDER=
VITE_WEBSITE_HOME=
# Mastra / Agent 接口
VITE_FUNAI_API_URL=http://127.0.0.1:4111
