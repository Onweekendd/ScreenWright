# 开发环境
VITE_NODE_ENV=development
# 打包主目录
VITE_PUBLIC_PATH=/
# 系统接口服务
VITE_API_BASE_URL=http://localhost:8080
# CITY 系统接口服务（可选）
VITE_API_BASE_URL_CITY=
# minio 素材库
VITE_MINIO_BASE_URL=http://localhost:9000/
VITE_MINIO_DEFAULT_PREFIX=version-test/
# 资源下载
VITE_RESOURCE_BASE_URL=http://localhost:8080
# 飞屏场景通信 socket.io 地址（可选）
VITE_SOCKET_IO_URL=
# 说明文档 / 官网（可选）
VITE_DOCUMENT_URL=
VITE_WEBSITE_PAY=
VITE_WEBSITE_ORDER=
VITE_WEBSITE_HOME=
# Mastra / Agent 接口
VITE_FUNAI_API_URL=http://localhost:4111
