{
  "name": "@screenwright/app",
  "private": true,
  "version": "2.0.0",
  "author": "blue",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:desktop": "vite --mode desktop --port 5173 --strictPort",
    "build": "pnpm build:lib && pnpm build:fontFace && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:desktop": "pnpm build:lib && pnpm build:fontFace && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode desktop",
    "build:stage": "pnpm build:lib && pnpm build:fontFace && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode staging",
    "build:prod": "pnpm build:lib && pnpm build:fontFace && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "preview:stage": "pnpm build:stage && vite preview",
    "preview:prod": "pnpm build:prod && vite preview",
    "lint:eslint": "eslint --cache --max-warnings 0 \"{src,tests,types}/**/*.{vue,js,jsx,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write \"{src,tests,types}/**/*.{vue,js,jsx,ts,tsx,json,css,less,scss,html,md}\"",
    "lint": "pnpm lint:eslint && pnpm lint:prettier",
    "lint:style": "stylelint \"./**/*.{css,less,scss,sass,vue,html}\" --fix --cache --cache-location node_modules/.cache/stylelint/ --ignore-path .gitignore",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage",
    "build:lib": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build -c vite.lib.config.ts",
    "build:lib:prod": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build -c vite.lib.config.ts",
    "build:sdk:types": "npx tsup && node scripts/bundle-sdk-types.mjs",
    "build:fontFace": "sass src/style/fontface.scss public/lib/fontface.css --no-source-map --style=compressed",
    "wc": "vite build --config vite.comp.config.ts",
    "check-types": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "@screenwright/types": "workspace:*",
    "@screenwright/core": "workspace:*",
    "@screenwright/material": "workspace:*",
    "@screenwright/composables": "workspace:*",
    "@js-preview/docx": "^1.6.4",
    "@js-preview/excel": "^1.7.14",
    "@js-preview/pdf": "^2.0.10",
    "@kjgl77/datav-vue3": "^1.7.4",
    "@mastra/client-js": "1.40.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.1",
    "@tinymce/tinymce-vue": "^6.1.0",
    "@vue/compiler-sfc": "^3.5.16",
    "@vue/shared": "3.5.21",
    "@vueuse/core": "^14.2.1",
    "@zumer/snapdom": "^2.0.1",
    "ai": "^6.0.111",
    "axios": "1.4.0",
    "@screenwright/alignment-wasm": "workspace:*",
    "crypto-js": "^4.0.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "echarts-gl": "^2.0.9",
    "echarts-liquidfill": "^3.1.0",
    "echarts-wordcloud": "^2.1.0",
    "element-plus": "^2.11.2",
    "flv.js": "^1.6.2",
    "@screenwright/ui": "workspace:*",
    "@screenwright/server": "workspace:*",
    "hls.js": "^1.5.20",
    "hono": "4.12.3",
    "html2canvas": "^1.4.1",
    "immer": "^10.1.1",
    "js-md5": "^0.7.3",
    "jszip": "^3.10.1",
    "lodash-es": "4.17.21",
    "marked": "^17.0.3",
    "mitt": "^3.0.1",
    "monaco-editor": "0.52.2",
    "page-flip": "^2.0.7",
    "photoswipe": "^5.4.4",
    "pinia": "2.1.4",
    "pptx-preview": "^1.0.7",
    "proj4": "^2.8.0",
    "psd.js": "^3.9.2",
    "qrcode": "^1.5.4",
    "rbush": "^4.0.1",
    "sass-loader": "^16.0.3",
    "semver": "^7.7.2",
    "socket.io-client": "^4.8.3",
    "stylelint": "^15.10.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^10.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^6.0.3",
    "stylelint-prettier": "^4.0.0",
    "stylelint-scss": "^5.0.1",
    "three": "^0.182.0",
    "three.meshline": "^1.4.0",
    "tinymce": "^5.10.2",
    "vue": "3.5.21",
    "vue-router": "4.2.2",
    "vue3-sketch-ruler": "^1.3.3",
    "vuedraggable": "^4.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@screenwright/eslint-config": "workspace:*",
    "@mastra/core": "1.59.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@trivago/prettier-plugin-sort-imports": "^4.2.0",
    "@types/crypto-js": "^4.2.2",
    "@types/js-md5": "^0.7.2",
    "@types/lodash-es": "4.17.7",
    "@types/node": "20.3.2",
    "@types/page-flip": "^2.0.3",
    "@types/proj4": "^2.5.6",
    "@types/qrcode": "^1.5.5",
    "@types/rbush": "^4.0.0",
    "@types/semver": "^7.7.1",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-vue": "4.2.3",
    "@vitejs/plugin-vue-jsx": "3.0.1",
    "@vue/test-utils": "2.4.0",
    "axios-mock-adapter": "^2.1.0",
    "cross-env": "^7.0.3",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^9.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "8.0.3",
    "jsdom": "^26.1.0",
    "lint-staged": "13.2.2",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "1.63.6",
    "terser": "5.18.1",
    "tsup": "^8.5.1",
    "typescript": "5.9.2",
    "vite": "4.3.9",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-image-optimizer": "^1.1.8",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-pwa": "^0.20.0",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-svg-loader": "4.0.0",
    "vitest": "0.32.2",
    "vue-tsc": "3.0.7",
    "workbox-cacheable-response": "^7.0.0",
    "workbox-core": "^7.0.0",
    "workbox-expiration": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0",
    "workbox-window": "^7.0.0"
  },
  "lint-staged": {
    "*.{vue,js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,less,scss,html,md}": [
      "prettier --write"
    ],
    "package.json": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
