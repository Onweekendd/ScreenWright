{
  "name": "@screenwright/artifact-app-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "check-types": "pnpm typecheck",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "vue": "3.5.21"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.2",
    "vite": "^7.2.7",
    "vitest": "^4.0.16",
    "vue-tsc": "3.0.7"
  }
}
