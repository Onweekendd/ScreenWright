{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenwright",
  "version": "0.1.0",
  "identifier": "cloud.screenwright.desktop",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm -w run desktop:frontend",
    "beforeBuildCommand": "pnpm -w run desktop:frontend:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screenwright",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/server": "server"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
