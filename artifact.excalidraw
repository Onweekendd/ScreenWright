      "updated": 1789459884124,
      "link": null,
      "locked": false,
      "text": "route\n\ncustomApi[\"bi-chat\"].$post\n\nhandleBiChat\n// 获取或创建一个对话流\n  const session = sessionRegistry.\ngetOrCreate(threadId!, resourceId!, requestSignal);\n\n// 启动session的这一轮对话 传入用户消息/客户端工具\n void session.runTurn({ messages, clientTools });\n\n// 串行队列执行\n  runTurn(args: RunTurnArgs): Promise<void> {\n// 等待上一轮完成后 执行当前这一轮次对话\n// runTurnWithRecording 用于记录llm对话轮次 使用 AsyncLocalStorage 在本次请求中注入上下文\n    const next = this.tail.then(() => this.runTurnWithRecording(args));\n    this.tail = next.catch(() => {}); \n    return next;\n  }\n\nrunTurnBody\n- buildTurnStream\n--createBIChatTurnStream\n---buildRequestContext (获取当前的三种模式 ASK AUTO PLAN)\n----startBIAgentStream\n----- mastraStream = swAgent.resumeStream | swAgent.stream （继续 |开启新一轮 turn）\n打平+重命名 background 的chunk 转化为 ai-sdk 类型的chunk\n-----const aiSdkStream = toAISdkStream(withRenamedBackgroundChunks(mastraStream, bgSubRunIds), {\n      from: \"agent\",\n      sendReasoning: true\n    });\n-----return createProcessedStream({\n      aiSdkStream: aiSdkStream as unknown as ReadableStream<unknown>,\n      snapshots,\n      threadId,\n      internalAbort: abortController,\n      usageRef,\n      bgSubRunIds\n    });\n\n\nfor await (const chunk of turnStream as unknown as AsyncIterable<TurnChunk>) {\n\nthis.push\n- await this.writer.write(chunk); // 背压：消费者慢就在这等\n\n\n\n\n\n\n\n// 返回流\n  return session.getStream() as ReadableStream;\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "route\n\ncustomApi[\"bi-chat\"].$post\n\nhandleBiChat\n// 获取或创建一个对话流\n  const session = sessionRegistry.\ngetOrCreate(threadId!, resourceId!, requestSignal);\n\n// 启动session的这一轮对话 传入用户消息/客户端工具\n void session.runTurn({ messages, clientTools });\n\n// 串行队列执行\n  runTurn(args: RunTurnArgs): Promise<void> {\n// 等待上一轮完成后 执行当前这一轮次对话\n// runTurnWithRecording 用于记录llm对话轮次 使用 AsyncLocalStorage 在本次请求中注入上下文\n    const next = this.tail.then(() => this.runTurnWithRecording(args));\n    this.tail = next.catch(() => {}); \n    return next;\n  }\n\nrunTurnBody\n- buildTurnStream\n--createBIChatTurnStream\n---buildRequestContext (获取当前的三种模式 ASK AUTO PLAN)\n----startBIAgentStream\n----- mastraStream = swAgent.resumeStream | swAgent.stream （继续 |开启新一轮 turn）\n打平+重命名 background 的chunk 转化为 ai-sdk 类型的chunk\n-----const aiSdkStream = toAISdkStream(withRenamedBackgroundChunks(mastraStream, bgSubRunIds), {\n      from: \"agent\",\n      sendReasoning: true\n    });\n-----return createProcessedStream({\n      aiSdkStream: aiSdkStream as unknown as ReadableStream<unknown>,\n      snapshots,\n      threadId,\n      internalAbort: abortController,\n      usageRef,\n      bgSubRunIds\n    });\n\n\nfor await (const chunk of turnStream as unknown as AsyncIterable<TurnChunk>) {\n\nthis.push\n- await this.writer.write(chunk); // 背压：消费者慢就在这等\n\n\n\n\n\n\n\n// 返回流\n  return session.getStream() as ReadableStream;\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
