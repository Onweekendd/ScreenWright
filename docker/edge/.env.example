# 香港边缘节点环境变量。复制成 .env 后修改：
#   cp .env.example .env

# 站点域名（A 记录必须已指向本机公网 IP）
DOMAIN=screenwright.design

# 源站网关的回源 TLS 地址 host:port，即国内机器上 web 容器映射出来的 HTTPS_PORT（默认 8443）。
# 下面是文档保留地址，部署时换成你的源站 IP。
ORIGIN=203.0.113.10:8443

# 源站 IP（不带端口），用来校验自签证书里的 IP，必须和证书的 subjectAltName 一致
ORIGIN_HOST=203.0.113.10
