{
  "name": "screenwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "author": "onweekend",
  "scripts": {
    "test": "turbo run test",
    "dev": "turbo run dev --filter=@screenwright/app",
    "server:dev": "turbo run server:dev --filter=@screenwright/server",
    "desktop": "pnpm --filter @screenwright/desktop dev",
    "desktop:build": "pnpm --filter @screenwright/desktop build",
    "desktop:package": "pnpm --filter @screenwright/desktop build:sidecar && pnpm desktop:build",
    "desktop:frontend": "turbo run dev:desktop --filter=@screenwright/app",
    "desktop:frontend:build": "turbo run build:desktop --filter=@screenwright/app",
    "dev:agent-trace": "pnpm --filter @screenwright/agent-trace dev",
    "dev:with:editor": "turbo run dev build:editor:watch",
    "build:lib": "turbo run build:lib",
    "build:sdk:types": "turbo run build:sdk:types",
    "build:repl:dev": "pnpm --filter @screenwright/code-editor build:dev",
    "build:workers:dev": "pnpm --filter @screenwright/code-editor build:workers:dev",
    "build:workers:prod": "pnpm --filter @screenwright/code-editor build:workers:prod",
    "install:all": "pnpm install",
    "build": "turbo run build && pnpm copy:dist",
    "build:stage": "turbo run build:stage && pnpm copy:dist",
    "build:prod": "turbo run build:prod && pnpm copy:dist",
    "copy:dist": "cpy 'apps/app/dist/**' dist",
    "check-types": "turbo run check-types",
    "prepare": "husky install",
    "lint:staged": "lint-staged --config lint-staged.config.mjs --concurrent false",
    "test:staged": "node scripts/test-staged.mjs"
  },
  "keywords": [],
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "@types/node": "^24.10.2",
    "concurrently": "^8.2.2",
    "cpy-cli": "^5.0.0",
    "husky": "8.0.3",
    "lint-staged": "16.1.4",
    "turbo": "^2.5.8"
  }
}
