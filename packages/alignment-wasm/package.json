{
  "name": "@screenwright/alignment-wasm",
  "version": "0.1.0",
  "description": "BI Alignment WASM package with R-tree spatial indexing and alignment lines",
  "scripts": {
    "alignment:build:build": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 release pkg",
    "alignment:build:wasm-pack": "wasm-pack build --target web --out-dir pkg",
    "alignment:build:wasm-pack:release": "wasm-pack build --target web --release --out-dir pkg",
    "clean": "rimraf pkg pkg target"
  },
  "exports": {
    ".": {
      "types": "./pkg/bi_alignment.d.ts",
      "import": "./pkg/bi_alignment.js"
    }
  },
  "keywords": [
    "wasm",
    "alignment",
    "r-tree",
    "spatial-index"
  ],
  "author": "Onweekend <weijianwang74@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "rimraf": "^5.0.0"
  }
}
