{
  "name": "@screenwright/types",
  "version": "1.0.0",
  "description": "Screenwright 类型系统和 Zod Schemas",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates.js"
    },
    "./types/action": {
      "types": "./dist/types/action.d.ts",
      "import": "./dist/types/action.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build",
    "watch": "vite build --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --fix",
    "format": "prettier --write src"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@screenwright/eslint-config": "workspace:*",
    "@types/node": "^24.10.2",
    "eslint": "^9.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^3.2.4"
  }
}
