        },
        "src/element-plus.js": {
          "code": "import ElementPlus from 'element-plus'\r\nimport { getCurrentInstance } from 'vue'\r\n\r\nlet installed = false\r\nawait loadStyle()\r\n\r\nexport function setupElementPlus() {\r\n  if (installed) return\r\n  const instance = getCurrentInstance()\r\n  instance.appContext.app.use(ElementPlus)\r\n  installed = true\r\n}\r\n\r\nexport function loadStyle() {\r\n  const styles = ['https://cdn.jsdelivr.net/npm/element-plus@2.11.2/dist/index.css', 'https://cdn.jsdelivr.net/npm/element-plus@2.11.2/theme-chalk/dark/css-vars.css'].map((style) => {\r\n    return new Promise((resolve, reject) => {\r\n      const link = document.createElement('link')\r\n      link.rel = 'stylesheet'\r\n      link.href = style\r\n      link.addEventListener('load', resolve)\r\n      link.addEventListener('error', reject)\r\n      document.body.append(link)\r\n    })\r\n  })\r\n  return Promise.allSettled(styles)\r\n}"
        }
      }
