# 模型配置（均按 OpenAI 兼容端点处理）。这里只是首启兜底：
# 首次启动时若 ai_model 表缺行，用下面的值 seed；之后以「设置」页为准，改这里不再生效。
# 全部留空也能启动，进「设置」页填即可。

# 推理模型：主 Agent / 子 Agent / 标题 / 摘要等一切文本推理
REASONING_MODEL_BASE_URL=
REASONING_MODEL_API_KEY=
REASONING_MODEL_ID=

# 视觉模型：识图 / 图片转大屏
VISION_MODEL_BASE_URL=
VISION_MODEL_API_KEY=
VISION_MODEL_ID=

# 嵌入模型：组件 RAG 检索（seed-embeddings / 设置页「重建索引」需要）
EMBEDDING_MODEL_BASE_URL=
EMBEDDING_MODEL_API_KEY=
EMBEDDING_MODEL_ID=
EMBEDDING_MODEL_DIMENSIONS=1024

# 生图模型：效果图 / 装饰素材生成。BASE_URL 只填到 provider 根路径（不带 /images/generations，
# SDK 会自己拼这段路径）。实测跑通的例子：豆包 seedream，走火山方舟 OpenAI 兼容端点——
# https://ark.cn-beijing.volces.com/api/v3 + doubao-seedream-5-0-pro-260628。
# 注意该服务商要求图像面积至少 921600 像素，尺寸太小会被直接拒绝。
#
# 也可以换成 gpt-image 系列（含 OpenAI 兼容的中转网关）：模型 id 以 gpt-image / dall-e 开头时自动按 OpenAI 格式请求
# （不发 seed / watermark / response_format，size 自动换成它接受的值，图生图走 /images/edits）。例：
#   IMAGE_MODEL_BASE_URL=https://llm-api.net/v1   IMAGE_MODEL_ID=gpt-image-2
IMAGE_MODEL_BASE_URL=
IMAGE_MODEL_API_KEY=
IMAGE_MODEL_ID=
# 可选：强制指定请求格式 ark | openai（网关给模型改了名、按 id 判断不出来时才需要）
# IMAGE_API_STYLE=
# 可选：gpt-image 的画质 low | medium | high | auto（越高越贵越慢；大屏上文字要清晰可以用 high）
# IMAGE_MODEL_QUALITY=
# 可选：提示词字数上限。有的网关限制 1000 字，超了不是报错就是被悄悄截断；配上后超长会在发请求前被拦下并提示精简
# IMAGE_PROMPT_MAX_CHARS=

# PostgreSQL（需 pgvector 扩展，推荐镜像 pgvector/pgvector:pg16；本地一键起见仓库根 docker-compose.dev.yml）。
# PRISMA_DATABASE_URL：Prisma 业务表（public schema）；
# MASTRA_DATABASE_URL：Mastra 记忆/线程/追踪 + 组件 RAG 向量（MASTRA_DATABASE_SCHEMA 指定 schema，默认 mastra）。
# 两者可指向同一个库。
MASTRA_DATABASE_URL=postgresql://funbi:funbi_dev@localhost:5432/funbi
# MASTRA_DATABASE_SCHEMA=mastra
MASTRA_WORKSPACE_PATH=./agent-workspace
# Artifact App 运行数据根目录；内部固定分为 apps/ 与 sessions/。
# 可选；未配置时默认为 ${MASTRA_WORKSPACE_PATH}/artifact-app
# ARTIFACT_APP_ROOT=./agent-workspace/artifact-app
PRISMA_DATABASE_URL=postgresql://funbi:funbi_dev@localhost:5432/funbi

# 进程角色：api | ai | worker | all（默认 all，一个进程全跑，本地开发用）。
# 生产形态同一个镜像起三种角色：api（业务接口）、ai（对话/agent，单副本）、worker（队列任务）。
# ROLE=all

# 任务队列（BullMQ）。配了 REDIS_URL 才走队列，由 ROLE=worker 的进程消费；没配则任务在当前进程内直接执行。
# 本地起 Redis：docker compose -f docker-compose.dev.yml up -d redis（宿主机端口 6380）
# REDIS_URL=redis://localhost:6380
# QUEUE_MODE=redis            # 可选：显式指定 redis | inline，覆盖自动判断
# QUEUE_PREFIX=funbi          # 可选：多个环境共用一个 Redis 时用来隔离
# IMAGE_WORKER_CONCURRENCY=2  # 可选：生图 worker 并发度，受上游生图接口限流约束

# 登录 / 鉴权
# JWT_SECRET：令牌签名密钥。生产环境（NODE_ENV=production）必须设置，缺失服务会拒绝签发令牌。
#   生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 令牌有效期（秒），默认 604800（7 天）
# JWT_EXPIRES_IN_SECONDS=604800
# 允许跨域访问的前端源，逗号分隔；前端与后端同域（ingress 反代）时可不填
# CORS_ORIGIN=https://bi.example.com
# 初始超管（pnpm seed-bi-user）：口令留空时，开发环境用 admin123，生产环境随机生成并只打印一次
# SEED_ADMIN_NAME=admin
# SEED_ADMIN_PASSWORD=

# 对象存储（素材、聊天贴图、Figma 资源、生图结果）
# STORAGE_DRIVER: fs（默认，落本地文件系统，见下方 BLOB_STORAGE_DIR）| minio
STORAGE_DRIVER=fs

# MinIO —— 仅当 STORAGE_DRIVER=minio 或 RECORD_SINK=both 时才用到。
# 纯 fs 部署可不装 minio 包（pnpm install --no-optional）。
# 留空 ACCESS/SECRET 即视为「未配置」，RECORD_SINK=both 会静默降级为纯 fs。
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=screenwright
# 对外可访问端点（如 cdn.example.com），留空用 ENDPOINT:PORT
MINIO_PUBLIC_ENDPOINT=

# 聊天录制归档
# RECORD_LLM：保存实际发给模型的请求与模型原始响应。
# RECORD_SINK: fs（默认，只写本地文件系统）| both（本地为主 + 额外镜像到 MinIO 供 agent-trace 集中查看）
# 记录恒写 <LLM_RECORD_DIR>/<LLM_RECORD_MINIO_PREFIX>/<threadId>/；读取本地优先、缺了回落 MinIO。
RECORD_SINK=fs
RECORD_LLM=true
LLM_RECORD_MINIO_PREFIX=llm-records
# 录制文件系统根目录，留空默认 <cwd>/.data/records
LLM_RECORD_DIR=

# 上下文压缩（代码默认全部关闭，见 src/mastra/lib/compaction/config.ts）
# L1：清理旧的工具结果（readFile / searchComponent / editFiles / executeInBrowser），
#     保留最近 3 轮。纯本地操作，不调模型，无成本，不影响决策链（调用记录仍在）。
COMPACTION_L1_ENABLED=true
# L3：摘要压缩历史消息。会调一次 summarizer 模型，有成本、有信息损失，
#     且会改写消息前缀导致 prompt 缓存失效——开之前想清楚这笔账。
COMPACTION_L3_ENABLED=true
# L3 触发阈值（prompt tokens）。注意：deepseek-v4 的上下文按 1,000,000 配置，
# 150k 只占 15%，属于偏早触发；调大可减少压缩频率与缓存失效。
COMPACTION_L3_TRIGGER_TOKENS=150000
# 其余可调项（留空走代码默认）：
# COMPACTION_L3_USER_KEEP=10       保留最近 N 条 user 消息不压缩
# COMPACTION_L3_COOLDOWN=5         压缩后 N 轮内不再触发

# 素材库本地 FS 存储（替代 MinIO）
# BLOB_STORAGE_DIR 留空默认 <cwd>/blob-storage
BLOB_STORAGE_DIR=
# 素材可访问地址前缀，留空默认 http://localhost:<DEV_PORT|4111>
ASSET_PUBLIC_BASE_URL=
