{
  "name": "@screenwright/server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dotenvx": "dotenvx",
    "sync-skill-overviews": "tsx scripts/sync-skill-overviews.ts",
    "inspect:llm": "tsx scripts/inspect-llm-record.ts",
    "server:dev": "dotenvx run -- tsx watch --conditions=development src/server.ts",
    "mastra:dev": "mastra dev",
    "mastra:build": "mastra build",
    "mastra:start": "mastra start",
    "lint:eslint": "eslint --cache --max-warnings 0 \"{src,tests,types}/**/*.{vue,js,jsx,ts,tsx}\" --fix",
    "init-figma-keys": "dotenvx run --  tsx scripts/seed-figma-keys.ts",
    "seed-embeddings": "dotenvx run --  tsx scripts/seed-component-embeddings.ts",
    "seed-modules": "dotenvx run --  tsx scripts/seed-modules.ts",
    "seed-bi-user": "dotenvx run --  tsx scripts/seed-bi-user.ts",
    "import-system-materials": "dotenvx run -- tsx scripts/import-system-materials.ts",
    "docker:seed-embeddings": "tsx scripts/seed-component-embeddings.ts",
    "docker:seed-modules": "tsx scripts/seed-modules.ts",
    "mastra:test": "dotenvx run --  vitest run",
    "eval": "dotenvx run -- tsx evals/harness/run.ts",
    "mastra:test:watch": "vitest --watch",
    "mastra:test:coverage": "vitest --coverage",
    "mastra:check-types": "tsc --noEmit && tsc -p tsconfig.agent-scripts.json",
    "check-types": "tsc --noEmit",
    "test": "vitest --run",
    "check-vue-part": "tsx scripts/check-vue-part.ts",
    "build:client": "rollup -c rollup.config.mjs",
    "build:server": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --packages=external"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "//files": "仅影响 pnpm deploy / pack（桌面端 sidecar 打包）；workspace 消费方仍走符号链接全目录",
  "files": [
    "dist",
    "generated",
    "prisma/schema.prisma"
  ],
  "exports": {
    "./rpc": {
      "types": "./dist/rpcClient.d.ts",
      "vite": "./src/mastra/api/client.ts",
      "default": "./dist/rpcClient.js"
    }
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@aihubmix/ai-sdk-provider": "^0.0.6",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@dotenvx/dotenvx": "^1.44.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@screenwright/types": "workspace:*",
    "@screenwright/core": "workspace:*",
    "@hono/node-server": "^2.0.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@hono/zod-validator": "^0.7.6",
    "@huggingface/tokenizers": "0.1.3",
    "@mastra/ai-sdk": "1.10.2",
    "@mastra/core": "1.66.0",
    "@mastra/evals": "1.10.1",
    "@mastra/hono": "1.7.8",
    "@mastra/libsql": "1.22.5",
    "@mastra/loggers": "1.3.1",
    "@mastra/mcp": "1.17.3",
    "@mastra/memory": "1.29.0",
    "@mastra/observability": "1.17.7",
    "@prisma/adapter-better-sqlite3": "7.2.0",
    "@prisma/client": "7.2.0",
    "@types/proper-lockfile": "^4.1.4",
    "ai": "^6.0.282",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "create-screenwright-app": "workspace:*",
    "dotenv": "^17.2.3",
    "echarts": "^5.5.1",
    "express": "^4.18.2",
    "@screenwright/figma-helper": "workspace:*",
    "hono": "4.13.7",
    "http-proxy": "1.18.1",
    "jszip": "^3.10.1",
    "mime": "^4.1.0",
    "mysql2": "^3.11.5",
    "pg": "^8.16.3",
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.34.3",
    "tsx": "^4.19.4",
    "undici": "^7.28.0",
    "ws": "^8.18.3",
    "yoga-layout": "^3.2.1",
    "zod": "^4.1.13"
  },
  "//optionalDependencies": "minio 仅在 STORAGE_DRIVER=minio 或 RECORD_SINK=both 时懒加载（见 src/lib/storage/minio-object-store.ts）；纯 fs 部署（开源 / 桌面 sidecar）可用 pnpm install --no-optional 剔除",
  "optionalDependencies": {
    "minio": "^8.0.7"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.121.0",
    "@figma/rest-api-spec": "^0.33.0",
    "@screenwright/eslint-config": "workspace:*",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@trivago/prettier-plugin-sort-imports": "^4.2.0",
    "@types/express": "^4.17.17",
    "@types/http-proxy": "1.17.16",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.2",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.5.12",
    "@vitest/ui": "^4.0.16",
    "archiver": "^7.0.1",
    "esbuild": "^0.27.4",
    "eslint": "^9.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "mastra": "1.29.0",
    "prettier": "^3.6.2",
    "prisma": "^7.0.0",
    "rollup": "^4.52.5",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^5.9.3",
    "vitest": "4.0.16",
    "vue": "^2.7.16",
    "vue-tsc": "^3.3.3"
  }
}
